<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      All traffic is outbound and device-initiated: the app polls public
      endpoints on its own schedule and nothing can reach in. No location
      permission is declared; location is entered manually unless the user opts
      into LocationManager later.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Runtime-requested from Android 13; ignored below it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Lifts Doze's network restrictions so overnight checks happen on the app's
      own schedule rather than being deferred into maintenance windows hours
      apart. Off-Play this can be declared without a reviewer deciding an
      astronomy app does not qualify.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gloaming">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Gloaming">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
