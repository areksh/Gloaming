<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      All traffic is outbound and device-initiated: the app polls public
      endpoints on its own schedule and nothing can reach in. No location
      permission is declared; location is entered manually unless the user opts
      into LocationManager later.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime-requested from Android 13; ignored below it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Lifts Doze's network restrictions so overnight checks happen on the app's
      own schedule rather than being deferred into maintenance windows hours
      apart. Off-Play this can be declared without a reviewer deciding an
      astronomy app does not qualify.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Re-arms the alarm after a reboot; alarms do not survive a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      Held while a scheduled poll runs, so the device does not sleep between the
      alarm firing and the fetch completing. Previously arrived transitively via
      WorkManager; it is declared here now that the scheduler is our own.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      Storm mode only: while a display is actually overhead the app follows it
      minute by minute, which needs a foreground service. `specialUse` is the
      honest type - this is not media, location or data sync - and off-Play it
      can be declared without a reviewer deciding an astronomy app does not
      qualify. It runs for the duration of an event and not otherwise.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gloaming">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Gloaming">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Both receivers are directBootAware so they are delivered before the
          device has been unlocked after a reboot. Without that, a phone set to
          reboot on a timer goes silent until someone picks it up.
        -->
        <receiver
            android:name=".work.PollReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!--
          Not directBootAware: a foreground service cannot be started before
          first unlock, and nobody is outside watching an aurora on a phone they
          have not unlocked since it rebooted.
        -->
        <service
            android:name=".work.StormService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Follows an aurora that is overhead now, polling every couple of minutes so the user standing outside sees it strengthen or fade. Starts only when the display is large, the sky is dark and the forecast is clear, and stops when any of those ends." />
        </service>

        <receiver
            android:name=".work.BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
