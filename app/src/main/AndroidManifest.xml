<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      All traffic is outbound and device-initiated: the app polls public
      endpoints on its own schedule and nothing can reach in. Location is typed
      in unless the user opts into reading it from LocationManager.
    -->
    <!--
      Coarse only. The aurora grid is one-degree cells and Open-Meteo is given a
      position rounded to about a kilometre, so fine location would buy nothing
      the app uses, and a typed-in position works with this denied forever.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
      Only for refreshing that same coarse position on a cadence the user chose
      - every few hours, say - with no screen open (ADR-0016). Requested when
      somebody picks such a cadence and never otherwise. It extends the coarse
      grant in time, not in precision; there is still no fine location.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime-requested from Android 13; ignored below it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Lifts Doze's network restrictions so overnight checks happen on the app's
      own schedule rather than being deferred into maintenance windows hours
      apart. Off-Play this can be declared without a reviewer deciding an
      astronomy app does not qualify.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Re-arms the alarm after a reboot; alarms do not survive a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      Held while a scheduled poll runs, so the device does not sleep between the
      alarm firing and the fetch completing. Previously arrived transitively via
      WorkManager; it is declared here now that the scheduler is our own.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      Watching minute by minute, which needs a foreground service: either
      automatically while a display is overhead, or because the user asked for
      it - the one path the system will not defer, and so the answer when Doze,
      battery saver or an OEM process killer has been eating the schedule.
      `specialUse` is the honest type - this is not media, location or data sync
      - and off-Play it can be declared without a reviewer deciding an astronomy
      app does not qualify. It runs for the duration of an event, or of a watch
      the user started, and not otherwise.
    -->
    <!--
      Calendar, for the one optional feature that needs it: writing starred
      events into the phone's calendar. Off by default and requested at the
      moment somebody turns it on, never on first run - the app is fully
      functional with both denied forever, and the Share and Export buttons on
      every event need neither.

      READ is needed alongside WRITE and is not a fishing licence: the provider
      requires a read to find which calendar to write to and to confirm a row
      the app itself created is still there. Nothing in the app ever reads an
      event it did not write.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      Backup is off, and device-to-device transfer is excluded separately in
      `data_extraction_rules.xml` because `allowBackup` does not cover it. The
      settings hold the precise position the user typed, and the point of
      keeping that in credential-encrypted storage is lost if the backup system
      copies it off the phone regardless.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gloaming">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Gloaming">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Both receivers are directBootAware so they are delivered before the
          device has been unlocked after a reboot. Without that, a phone set to
          reboot on a timer goes silent until someone picks it up.
        -->
        <receiver
            android:name=".work.PollReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!--
          Not directBootAware: a foreground service cannot be started before
          first unlock, and nobody is outside watching an aurora on a phone they
          have not unlocked since it rebooted.
        -->
        <service
            android:name=".work.StormService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Follows an aurora that is overhead now, polling every couple of minutes so the user standing outside sees it strengthen or fade. Starts either automatically - only when the display is large, the sky is dark and the forecast is clear, stopping when any of those ends - or because the user asked for it, in which case it runs until they stop it. Capped at four hours either way." />
        </service>

        <!--
          Not directBootAware, for the same reason as the service it starts.
        -->
        <receiver
            android:name=".work.PassReceiver"
            android:exported="false" />

        <!--
          The background location refresh. Not directBootAware: the cadence and
          the position it replaces live in credential-encrypted storage, and a
          wake before first unlock could read neither. The reboot that locks the
          phone also clears the alarm, and BootReceiver arms it again once the
          phone is unlocked.
        -->
        <receiver
            android:name=".work.LocationReceiver"
            android:exported="false" />

        <!--
          The "Follow it" action on a pass notification. Not exported: only this
          app's own notification may press it.
        -->
        <receiver
            android:name=".work.FollowPassReceiver"
            android:exported="false" />

        <!--
          Takes the "was it worth it?" answer off an alert. Not exported: only
          the app's own notification may press it, and what it records is the
          one thing the release gate is waiting on.
        -->
        <receiver
            android:name=".work.WorthItReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <service
            android:name=".work.PassService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Follows a single satellite pass across the sky while it happens, showing a live countdown, direction and elevation for a user standing outside. Started shortly before the satellite rises, either because the user asked for that pass or because they asked for every space station pass, and stops when the pass ends. Uses no network at all - the orbital elements are already on the device - and is capped at thirty minutes." />
        </service>

        <!--
          The "Follow it" action on an eclipse notification. Not exported, on
          the same reasoning as the pass one.
        -->
        <receiver
            android:name=".work.FollowEclipseReceiver"
            android:exported="false" />

        <service
            android:name=".work.EclipseService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Counts a solar or lunar eclipse down contact by contact for a user standing outside, showing the time to the next contact and where in the sky to look. Started only when the user presses the action on an eclipse notification, and stops after the last contact. Uses no network at all - an eclipse is computed on the device - and is capped at three hours, which is past the longest umbral lunar eclipse." />
        </service>

        <!--
          Hands out the exported log, and nothing else - see res/xml/shared_paths.
          Not exported and permission-granting only, so a receiving app gets a
          one-shot read of the copy the user chose to send and no access to
          anything the app stores.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_paths" />
        </provider>

        <!--
          Direct Boot aware like the rest: a poll before first unlock should be
          able to redraw the widget it just produced a reading for.
        -->
        <receiver
            android:name=".widget.AuroraWidget"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_aurora_info" />
        </receiver>

        <receiver
            android:name=".work.BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!--
                  An update cancels this app's alarms exactly as a reboot does,
                  and the app is installed from stores that update in the
                  background. Without this the schedule dies at the update and
                  stays dead until somebody opens the app - which nothing about
                  the app looks wrong enough to prompt. One of the few implicit
                  broadcasts a manifest receiver is still delivered.
                -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
