<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is zero on purpose. The system's own widget refresh has a
  30-minute floor and wakes the device to honour it, which would duplicate the
  adaptive schedule and undo its savings. The widget is redrawn by the poll
  instead, so it is exactly as fresh as the data behind it and costs nothing of
  its own.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_aurora"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
