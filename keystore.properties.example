# Signing material for the release build.
#
# Copy this to `keystore.properties` beside it and fill in the passphrase. That
# file is gitignored by name; this one is the template, and holds no secret.
#
#     cp keystore.properties.example keystore.properties
#
# Only the machine that cuts releases needs it. Every other machine builds debug
# and `minified` without it, and a release build refuses rather than emitting an
# APK signed with a key nobody can update from. See docs/prerequisites.md.
#
# The same four values can be given as GLOAMING_KEYSTORE,
# GLOAMING_KEYSTORE_PASSWORD, GLOAMING_KEY_ALIAS and GLOAMING_KEY_PASSWORD
# instead, for a machine that would rather hold no file.

# Relative to the repository root, or absolute.
storeFile=secrets/gloaming-release.p12

# The passphrase set when the keystore was generated. One passphrase covers the
# store and the key, PKCS12 being one file.
storePassword=

# Defaults to `gloaming` when left blank, which is the alias the project's key
# was generated under.
keyAlias=gloaming

# Defaults to storePassword when left blank, which is right for a PKCS12 store.
keyPassword=
